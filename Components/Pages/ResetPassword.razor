@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using BlazorMessagingApp.Auth
@using BlazorMessagingApp.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Reset password</PageTitle>

<div class="auth-card">
    <h1>Reset password</h1>
    @if (done)
    {
        <p>Your password has been reset. You can now <a href="login">log in</a>.</p>
    }
    else
    {
        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="ResetAsync" method="post">
            <DataAnnotationsValidator />
            <label>New password
                <InputText type="password" class="form-control" @bind-Value="Input.Password" autocomplete="new-password" />
            </label>
            <label>Confirm password
                <InputText type="password" class="form-control" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            </label>
            <ValidationSummary class="text-danger" />
            @foreach (var e in errors)
            {
                <p class="text-danger">@e</p>
            }
            <button class="btn btn-primary" type="submit">Reset password</button>
        </EditForm>
    }
</div>

@code {
    // The form posts back to this same URL, so the link's query string is still available on submit.
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromForm] private ResetModel Input { get; set; } = default!;
    private List<string> errors = [];
    private bool done;

    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        var token = AccountEmailService.DecodeToken(Code);
        var user = UserId is null ? null : await UserManager.FindByIdAsync(UserId);
        if (user is null || token is null)
        {
            errors = ["This reset link is invalid or has expired."];
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded) done = true;
        else errors = result.Errors.Select(e => e.Description).ToList();
    }

    private class ResetModel
    {
        [Required, DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
