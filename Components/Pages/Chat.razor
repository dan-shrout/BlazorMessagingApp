@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using BlazorMessagingApp.Auth
@using BlazorMessagingApp.Hubs
@using BlazorMessagingApp.Models
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject HubTicketStore Tickets

<PageTitle>Chat</PageTitle>

@if (!joined)
{
    <div class="join-card">
        <h1>Join a chat</h1>
        <form @onsubmit="JoinAsync">
            <p>Signed in as <strong>@userName</strong></p>
            <label>Room
                <input class="form-control" @bind="roomName" maxlength="50" list="rooms" />
                <datalist id="rooms">
                    @foreach (var r in SuggestedRooms)
                    {
                        <option value="@r"></option>
                    }
                </datalist>
            </label>
            <button class="btn btn-primary" type="submit"
                    disabled="@string.IsNullOrWhiteSpace(roomName)">
                Join
            </button>
            @if (error is not null)
            {
                <p class="text-danger">@error</p>
            }
        </form>
    </div>
}
else
{
    <div class="chat">
        <header class="chat-header">
            <strong>@(dmPartner is null ? $"#{roomName}" : $"✉ {dmPartner}")</strong>
            <span class="status @(IsConnected ? "online" : "offline")">@(connection?.State)</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LeaveAsync">Leave</button>
            <form method="post" action="/logout">
                <button class="btn btn-sm btn-outline-danger" type="submit">Log out</button>
            </form>
        </header>

        <div class="chat-body">
            <div class="messages" @ref="messageList">
                @foreach (var item in CurrentItems)
                {
                    @if (!item.Notice)
                    {
                        <div class="msg @(item.User == userName ? "mine" : "")">
                            <div class="meta">
                                <span class="author">@item.User</span>
                                <span class="time">@item.SentAt.ToLocalTime().ToString("t")</span>
                            </div>
                            <div class="text">@item.Text</div>
                        </div>
                    }
                    else
                    {
                        <div class="notice">@item.Text</div>
                    }
                }
            </div>

            <aside class="users">
                <button class="side-item @(dmPartner is null ? "active" : "")" @onclick="ShowRoom"># @roomName</button>

                <h6>Online (@users.Length)</h6>
                <ul>
                    @foreach (var u in users)
                    {
                        @if (IsMe(u))
                        {
                            <li class="me">@u (you)</li>
                        }
                        else
                        {
                            <li><button class="side-item" title="Send a private message" @onclick="() => OpenDmAsync(u)">@u</button></li>
                        }
                    }
                </ul>

                <h6>Private messages</h6>
                <ul>
                    @foreach (var c in conversations)
                    {
                        <li>
                            <button class="side-item @(IsPartner(c) ? "active" : "")" @onclick="() => OpenDmAsync(c)">
                                @c
                                @if (unread.GetValueOrDefault(c) > 0)
                                {
                                    <span class="unread">@unread[c]</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
                <form @onsubmit="StartDmAsync">
                    <input class="form-control form-control-sm" placeholder="Message a username" @bind="newDm" autocomplete="off" />
                </form>
                @if (dmError is not null)
                {
                    <p class="text-danger small">@dmError</p>
                }
            </aside>
        </div>

        <div class="typing">@(dmPartner is null && typingUsers.Count > 0 ? $"{string.Join(", ", typingUsers.Keys)} typing…" : "")</div>

        <form class="composer" @onsubmit="SendAsync">
            <input class="form-control" placeholder="@(dmPartner is null ? "Type a message" : $"Message {dmPartner}")" @bind="draft" @bind:event="oninput" @bind:after="OnDraftInput" autocomplete="off" disabled="@(!IsConnected)" />
            <button class="btn btn-primary" type="submit"
                    disabled="@(!IsConnected || string.IsNullOrWhiteSpace(draft))">Send</button>
        </form>
    </div>
}

@code {
    private static readonly string[] SuggestedRooms = ["general", "random", "help"];

    private record Item(string? User, string Text, DateTime SentAt = default, bool Notice = false);

    private HubConnection? connection;
    private ElementReference messageList;
    private readonly List<Item> items = [];      // room messages
    private readonly List<Item> dmItems = [];    // messages of the open private conversation
    private readonly List<string> conversations = [];
    private readonly Dictionary<string, int> unread = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, DateTime> typingUsers = new(StringComparer.OrdinalIgnoreCase);
    private string[] users = [];
    private string userName = "";
    private string userId = "";
    private string roomName = "general";
    private string draft = "";
    private string newDm = "";
    private string? dmPartner;
    private string? dmError;
    private string? error;
    private bool joined;
    private DateTime lastTypingSent = DateTime.MinValue;
    private bool scrollPending;

    private bool IsConnected => connection?.State == HubConnectionState.Connected;
    private List<Item> CurrentItems => dmPartner is null ? items : dmItems;
    private bool IsMe(string name) => string.Equals(name, userName, StringComparison.OrdinalIgnoreCase);
    private bool IsPartner(string name) => string.Equals(name, dmPartner, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        userName = user.Identity.Name ?? "";
        userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    private async Task JoinAsync()
    {
        error = null;
        roomName = roomName.Trim().ToLowerInvariant();

        try
        {
            connection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/chathub"), options =>
                {
                    // Called on every (re)connect, so each attempt gets a fresh ticket.
                    options.AccessTokenProvider = () => Task.FromResult<string?>(Tickets.Issue(userId, userName));
                })
                .WithAutomaticReconnect()
                .Build();

            connection.On<ChatMessage>("ReceiveMessage", async m =>
            {
                typingUsers.Remove(m.User);
                items.Add(new Item(m.User, m.Text, m.SentAt));
                await Refresh(scroll: dmPartner is null);
            });
            connection.On<DirectMessage>("ReceiveDirectMessage", OnDirectMessage);
            connection.On<string>("UserJoined", async u => { items.Add(new Item(null, $"{u} joined", Notice: true)); await Refresh(dmPartner is null); });
            connection.On<string>("UserLeft", async u => { items.Add(new Item(null, $"{u} left", Notice: true)); await Refresh(dmPartner is null); });
            connection.On<string[]>("PresenceChanged", async list => { users = list; await Refresh(); });
            connection.On<string>("UserTyping", OnUserTyping);

            // After an automatic reconnect the server has forgotten us, so rejoin the room.
            connection.Reconnected += async _ => await EnterRoomAsync();
            connection.Reconnecting += _ => Refresh();
            connection.Closed += _ => Refresh();

            await connection.StartAsync();
            await EnterRoomAsync();
            joined = true;
        }
        catch (Exception ex)
        {
            error = $"Could not join: {ex.Message}";
            await DisposeConnectionAsync();
        }
    }

    private async Task EnterRoomAsync()
    {
        var hub = connection!;
        var history = await hub.InvokeAsync<List<ChatMessage>>("JoinRoom", roomName);
        items.Clear();
        items.AddRange(history.Select(m => new Item(m.User, m.Text, m.SentAt)));

        var summaries = await hub.InvokeAsync<List<ConversationSummary>>("GetConversations");
        conversations.Clear();
        conversations.AddRange(summaries.Select(s => s.User));
        unread.Clear();
        foreach (var s in summaries.Where(s => s.Unread > 0)) unread[s.User] = s.Unread;

        // Reload the open conversation too, so anything missed while disconnected shows up.
        if (dmPartner is not null) await LoadConversationAsync(dmPartner);
        await Refresh(scroll: true);
    }

    private async Task SendAsync()
    {
        var text = draft.Trim();
        if (text.Length == 0 || !IsConnected) return;
        draft = "";

        if (dmPartner is null)
        {
            await connection!.SendAsync("SendMessage", text);
            return;
        }

        try { await connection!.InvokeAsync("SendDirectMessage", dmPartner, text); }
        catch (HubException ex) { dmError = ErrorText(ex); }
    }

    // ---- Private messages ----

    // With detailed errors on (development) SignalR wraps the message; show just the part we wrote.
    private static string ErrorText(HubException ex) => ex.Message.Split("HubException: ").Last();

    private Task StartDmAsync()
    {
        var name = newDm.Trim();
        newDm = "";
        return name.Length == 0 ? Task.CompletedTask : OpenDmAsync(name);
    }

    private async Task OpenDmAsync(string partner)
    {
        dmError = null;
        if (IsMe(partner)) { dmError = "You can't message yourself."; return; }

        try
        {
            await LoadConversationAsync(partner);
            await Refresh(scroll: true);
        }
        catch (HubException ex)
        {
            dmError = ErrorText(ex);
        }
    }

    /// <summary>Loads history for a partner, opens it, and clears its unread count (the server marks it read).</summary>
    private async Task LoadConversationAsync(string partner)
    {
        var convo = await connection!.InvokeAsync<Conversation>("OpenConversation", partner);

        dmPartner = convo.User;
        dmItems.Clear();
        dmItems.AddRange(convo.Messages.Select(m => new Item(m.FromUserName, m.Text, m.SentAt)));
        unread.Remove(convo.User);
        TouchConversation(convo.User);
    }

    private async Task OnDirectMessage(DirectMessage m)
    {
        var partner = IsMe(m.FromUserName) ? m.ToUserName : m.FromUserName;
        TouchConversation(partner);

        if (IsPartner(partner))
        {
            dmItems.Add(new Item(m.FromUserName, m.Text, m.SentAt));
            if (!IsMe(m.FromUserName)) await connection!.SendAsync("MarkConversationRead", partner);
            await Refresh(scroll: true);
        }
        else
        {
            if (!IsMe(m.FromUserName)) unread[partner] = unread.GetValueOrDefault(partner) + 1;
            await Refresh();
        }
    }

    /// <summary>Moves a partner to the top of the conversation list, adding it if new.</summary>
    private void TouchConversation(string partner)
    {
        conversations.RemoveAll(c => string.Equals(c, partner, StringComparison.OrdinalIgnoreCase));
        conversations.Insert(0, partner);
    }

    private async Task ShowRoom()
    {
        dmPartner = null;
        dmError = null;
        await Refresh(scroll: true);
    }

    // ---- Room extras ----

    private async Task OnDraftInput()
    {
        if (dmPartner is not null || !IsConnected || DateTime.UtcNow - lastTypingSent < TimeSpan.FromSeconds(2)) return;
        lastTypingSent = DateTime.UtcNow;
        await connection!.SendAsync("Typing");
    }

    private async Task OnUserTyping(string user)
    {
        var stamp = DateTime.UtcNow;
        typingUsers[user] = stamp;
        await Refresh();

        await Task.Delay(3000);
        if (typingUsers.TryGetValue(user, out var latest) && latest == stamp)
        {
            typingUsers.Remove(user);
            await Refresh();
        }
    }

    private async Task LeaveAsync()
    {
        await DisposeConnectionAsync();
        items.Clear();
        dmItems.Clear();
        conversations.Clear();
        unread.Clear();
        users = [];
        typingUsers.Clear();
        dmPartner = null;
        dmError = null;
        joined = false;
    }

    private Task Refresh(bool scroll = false)
    {
        scrollPending |= scroll;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollPending)
        {
            scrollPending = false;
            await JS.InvokeVoidAsync("chatScrollToBottom", messageList);
        }
    }

    private async Task DisposeConnectionAsync()
    {
        if (connection is not null)
        {
            await connection.DisposeAsync();
            connection = null;
        }
    }

    public async ValueTask DisposeAsync() => await DisposeConnectionAsync();

    [Inject] private IJSRuntime JS { get; set; } = default!;
}
